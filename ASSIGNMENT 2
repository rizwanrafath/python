 2.loops that count attempts 

correct_otp = "1234"
attempts = 0

while attempts < 3:
    otp = input("Enter OTP: ")

    if otp == "":
        print("Blank entry! Try again.")
        continue

    attempts += 1

    if otp == correct_otp:
        print("OTP Verified Successfully")
        break

    else:
        print("Wrong OTP")

else:
    print("Account Locked for 30 minutes")

3. changed condition - two extra attempts

 correct_otp = "1234"
security_answer = "python"

attempts = 0
max_attempts = 3

while attempts < max_attempts:

    otp = input("Enter OTP: ")

