lLIST AND SLICING DAILY RAINFALL RECORDS

import random
import time

# Generate 365 days of rainfall data
readings = [random.randint(0, 50) for _ in range(365)]

# 1. Weekly rainfall totals using slicing
weekly_totals = []

for i in range(0, 365, 7):
    weekly_totals.append(sum(readings[i:i+7]))

print("Weekly Rainfall Totals:", weekly_totals)

# 2. Maximum and minimum rainfall
print("Maximum Rainfall:", max(readings))
print("Maximum Position:", readings.index(max(readings)))

print("Minimum Rainfall:", min(readings))
print("Minimum Position:", readings.index(min(readings)))

# 3. Seven-day moving average
moving_average = []

for i in range(len(readings) - 6):
    avg = sum(readings[i:i+7]) / 7
    moving_average.append(avg)

print("7-Day Moving Average:", moving_average)

# 4. Find dry days (0 mm)
dry_days = []

for i in range(len(readings)):
    if readings[i] == 0:
        dry_days.append(i + 1)

print("Dry Days:", dry_days)

# 5. Running sum moving average
running_average = []
window_sum = sum(readings[:7])

running_average.append(window_sum / 7)

for i in range(7, len(readings)):
    window_sum += readings[i] - readings[i-7]
    running_average.append(window_sum / 7)

print("Running Sum Average:", running_average)

# 6. Experimental investigation
for n in [365, 36500, 365000]:

    data = [random.randint(0, 50) for _ in range(n)]

    # Naive method
    start = time.time()

    naive = [
        sum(data[i:i+7]) / 7
        for i in range(n-6)
    ]

    naive_time = time.time() - start

    # Running sum method
    start = time.time()

    total = sum(data[:7])
    result = [total / 7]

    for i in range(7, n):
        total += data[i] - data[i-7]
        result.append(total / 7)

    running_time = time.time() - start

    print("\nReadings:", n)
    print("Naive Time:", naive_time)
    print("Running Sum Time:", running_time)

# 7. Testing empty and short lists
def moving_average_test(data):
    if len(data) < 7:
        return []

    return [
        sum(data[i:i+7]) / 7
        for i in range(len(data)-6)
    ]

print("Empty List:", moving_average_test([]))
print("Short List:", moving_average_test([10, 20, 30]))


